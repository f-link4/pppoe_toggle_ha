; pppoe_toggle_ha configuration

; VHID to react on (matches @<VHID> in CARP events)
vhid = 1

; WAN interface key in pfSense (usually 'wan')
ifkey = wan

; Hostnames of the two CARP nodes (as returned by `hostname`)
nodeA = gateway1
nodeB = gateway2

; SSH key for inter-node communication
ssh_key = /root/.ssh/secret.ssh

; Timeouts (seconds)
cooldown_time = 10
ip_timeout = 30
conn_timeout = 300

; State file paths (usually don't change)
state_file = /tmp/pppoe_toggle_ha.state
cooldown_file = /tmp/pppoe_toggle_ha.cooldown

; Hide WAN from pfSense GUI when CARP is BACKUP
; true  = WAN disappears from GUI on BACKUP (like disabled interface)
; false = WAN stays in GUI with ↑↓ arrow (default)
; WARNING: writes to /cf/conf/config.xml on every CARP event
hide_wan_gui = false
