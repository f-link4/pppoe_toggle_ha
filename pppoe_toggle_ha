 * @link https://github.com/f-link4/pppoe_toggle_ha
 */

if ($argc < 2 || in_array(strtolower($argv[1] ?? ''), ['help', '-h', '--help'])) {
    echo "=======================================================================\n";
    echo "  PPPoE Toggle HA — WAN interface management for CARP failover events\n";
    echo "=======================================================================\n";
    echo "Usage:\n";
    echo "  pppoe_toggle_ha @<VHID> MASTER    - Enable WAN (CARP MASTER)\n";
    echo "  pppoe_toggle_ha @<VHID> BACKUP    - Disable WAN (CARP BACKUP)\n";
    echo "  pppoe_toggle_ha RECONCILE         - Check and set state at boot\n";
    echo "  pppoe_toggle_ha RECONNECT         - Force WAN reconnect\n";
    echo "  pppoe_toggle_ha set_vhid <number> - Set VHID to react on\n";
    echo "  pppoe_toggle_ha help              - Show this help\n";
    echo "=======================================================================\n";
    exit(0);
}

if (isset($argv[1]) && strtolower($argv[1]) === 'set_vhid') {
    if (!isset($argv[2]) || !is_numeric($argv[2])) {
        echo "Usage: pppoe_toggle_ha set_vhid <number>\n";
        exit(1);
    }
    $new_vhid = (int)$argv[2];
    $script = file_get_contents(__FILE__);
    $pattern = '/^(\$vhidX\s*=\s*)\d+\s*;/m';
    if (preg_match($pattern, $script, $matches)) {
        $new_line = $matches[1] . $new_vhid . ';';
        $script = preg_replace($pattern, $new_line, $script);
        $bak = __FILE__ . '.bak.' . date('YmdHis');
        if (!@copy(__FILE__, $bak)) {
            echo "Warning: could not create backup {$bak}\n";
        }
        $tmp = __FILE__ . '.tmp.' . getmypid();
        if (file_put_contents($tmp, $script) === false) {
            echo "Error: failed to write temp file\n";
            exit(1);
        }
        if (!@rename($tmp, __FILE__)) {
            echo "Error: failed to install updated script\n";
            @copy($bak, __FILE__);
            exit(1);
        }

        echo "VHID updated to {$new_vhid} (backup: {$bak})\n";
        exit(0);
    }
}

require_once("config.inc");
require_once("interfaces.inc");
require_once("services.inc");
require_once("util.inc");

$subsystem = $argv[1] ?? '';
$type = strtoupper($argv[2] ?? '');

$vhidX = 1;
$state_file = "/tmp/pppoe_toggle_ha.state";
$cooldown_file = '/tmp/pppoe_toggle_ha.cooldown';
$cooldown_sec = 10;
$ip_timeout = 30;
$ifkey      = 'wan';
$real_iface = get_real_interface($ifkey, "inet");
$track_ifaces = link_interface_to_track6($ifkey);

function check_cooldown() {
    global $cooldown_file, $cooldown_sec;
    $fp = fopen($cooldown_file, 'c+');
    if ($fp === false) {
        syslog(LOG_WARNING, "[pppoe_toggle_ha] cannot open cooldown file {$cooldown_file}");
        return true;
    }
    $allowed = false;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $last = (int)trim(stream_get_contents($fp));
        if (time() - $last >= $cooldown_sec) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, (string)time());
            $allowed = true;
        }
        flock($fp, LOCK_UN);
    }
    fclose($fp);
    return $allowed;
}

function pppoe_state($ifkey) {
    if (empty($ifkey)) {
        return ['active' => false, 'ip4' => false, 'ip6' => false];
    }

    $ip4 = get_interface_ip($ifkey);
    $ip6 = get_interface_ipv6($ifkey);

    $ip4 = !empty($ip4) && $ip4 !== '0.0.0.0' && $ip4 !== '127.0.0.1';
    $ip6 = !empty($ip6) && strpos($ip6, 'fe80:') !== 0;

    return [
        'active' => $ip4 || $ip6,
        'ip4' => $ip4,
        'ip6' => $ip6,
    ];
}

function wait_for_wan_ip4(): bool
{
    global $ifkey, $ip_timeout;

    $deadline = time() + $ip_timeout;
    while (time() < $deadline) {
        $ip4 = get_interface_ip($ifkey);
        if (!empty($ip4) && $ip4 !== "0.0.0.0") {
            return true;
        }
        usleep(200000); // 200 ms
    }

    return false;
}

function wait_for_wan_ip6(): bool
{
    global $ifkey, $ip_timeout;

    $deadline = time() + $ip_timeout;
    while (time() < $deadline) {
        $ip6 = get_interface_ipv6($ifkey);
        if (!empty($ip6) && strpos($ip6, 'fe80:') !== 0) {
            return true;
        }
        usleep(200000); // 200 ms
    }

    return false;
}

function flush_lan_ipv6(): void
{
    global $config, $ifkey, $track_ifaces;

    if (empty($track_ifaces)) {
        return;
    }

    foreach ($track_ifaces as $iface => $ifcfg) {
        if (empty($config['interfaces'][$iface])) {
            continue;
        }

        $real_iface = get_real_interface($iface, 'inet6');
        $ip6 = get_interface_ipv6($iface);

        if (!empty($ip6)) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function flush_wan_ipv6(): void
{
    global $real_iface;

    if (empty($real_iface)) {
        return;
    }

    $out = shell_exec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 2>/dev/null");
    if (empty($out)) {
        return;
    }

    if (preg_match_all('/inet6\s+([0-9a-fA-F:]+)(?:%[^\s]+)?/i', $out, $m)) {
        foreach ($m[1] as $ip6) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function kill_states_on_interface($iface)
{
    pfSense_kill_states("0.0.0.0/0", $iface);
    pfSense_kill_states("::/0", $iface);
}

function manage_dhcpdv6($mode): void
{
    global $config, $ifkey, $track_ifaces;

    if (empty($track_ifaces)) {
        return;
    }

    $changed = false;
    foreach (array_keys($track_ifaces) as $if) {
        if ($mode === 'enable') {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== 'assist') {
                $config['dhcpdv6'][$if]['ramode'] = 'assist';
                $changed = true;
            }
            if (!isset($config['dhcpdv6'][$if]['enable'])) {
                $config['dhcpdv6'][$if]['enable'] = '';
                $changed = true;
            }
        } else {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== 'disabled') {
                $config['dhcpdv6'][$if]['ramode'] = 'disabled';
                $changed = true;
            }
            if (isset($config['dhcpdv6'][$if]['enable'])) {
                unset($config['dhcpdv6'][$if]['enable']);
                $changed = true;
            }
        }
    }

    if ($changed) {
        write_config("CARP: " . ($mode === 'enable' ? 'Enabled' : 'Disabled') . " radvd+DHCPv6 on " . implode(',', array_keys($track_ifaces)), false);
        services_radvd_configure();
        services_dhcpdv6_configure();
    }
}

function update_state_file($state, $write = false): bool
{
    global $vhidX, $state_file;

    $new_state = "@{$vhidX}|{$state}";
    $fp = fopen($state_file, 'c+');
    if ($fp === false) {
        return true;
    }

    $changed = true;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $old_state = trim(stream_get_contents($fp));
        $changed = ($old_state !== $new_state);

        if ($write && $changed) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, $new_state);
        }

        flock($fp, LOCK_UN);
    }
    fclose($fp);

    return $changed;
}

function apply_carp_state($state): void
{
    global $config, $type, $ifkey, $real_iface, $pppoe_state, $is_enabled;

    switch ($state) {

        case 'MASTER':
            if (!$pppoe_state['active']) {

                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " up");

                if (wait_for_wan_ip4()) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                } else {
                    exit(1);
                }

                if (!wait_for_wan_ip6()) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                }

                if (!$is_enabled) {
                    //$config['interfaces'][$ifkey]['enable'] = '1';
                    //write_config("enable interface '{$ifkey}' due CARP event '{$state}'", false);
                    //interface_configure($ifkey);
                }

                if (wait_for_wan_ip6()) {
                    manage_dhcpdv6('enable');
                }

            }
            break;

        case 'BACKUP':
            if ($pppoe_state['active']) {

                manage_dhcpdv6('disable');

                if ($is_enabled) {
                    //unset($config['interfaces'][$ifkey]['enable']);
                    //write_config("disable interface '{$ifkey}' due CARP event '{$state}'", false);
                    //interface_configure($ifkey);
                }

                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " down");
                kill_states_on_interface($real_iface);

                flush_wan_ipv6();
                flush_lan_ipv6();
            }
            break;

        case 'INIT':
        default:
            break;
    }
    update_state_file($state, true);
}

$carp_state = preg_match('/carp:\s+(MASTER|BACKUP|INIT)\s+vhid\s+' . preg_quote((string)$vhidX, '/') . '/i', shell_exec("/sbin/ifconfig -a 2>/dev/null"), $m) ? strtoupper($m[1]) : '';
$pppoe_state = pppoe_state($ifkey);
$is_enabled = isset($config['interfaces'][$ifkey]['enable']);

if (isset($argv[1]) && strtoupper($argv[1]) === 'RECONCILE') {
    apply_carp_state($carp_state);
    exit(0);
}

if (isset($argv[1]) && strtoupper($argv[1]) === 'RECONNECT') {
    if ($pppoe_state['active']) {
        interface_configure($ifkey);
    }
    exit(0);
}

if (preg_match('/@(\d+)$/', $subsystem, $matches) || preg_match('/^(\d+)@/', $subsystem, $matches)) {
    $vhid = (int)$matches[1];
} else {
    exit(1);
}

if (!in_array($type, ['MASTER', 'BACKUP', 'INIT'])) {
    exit(1);
}

if ($vhid !== $vhidX) {
    exit(0);
}

if (!update_state_file($type)) {
    exit(0);
}

if (!check_cooldown()) {
    exit(0);
}

apply_carp_state($type);
