        echo "Usage: pppoe_toggle_ha set_vhid <number>\n";
        exit(1);
    }
    $new_vhid = (int)$argv[2];
    $script = file_get_contents(__FILE__);
    $pattern = '/^(\$vhidX\s*=\s*)\d+\s*;/m';
    if (preg_match($pattern, $script, $matches)) {
        $new_line = $matches[1] . $new_vhid . ';';
