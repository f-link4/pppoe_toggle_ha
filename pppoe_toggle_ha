    echo "=============================================================================\n";
    exit(0);
}

if (isset($argv[1]) && strtolower($argv[1]) === 'set_vhid') {
    if (!isset($argv[2]) || !is_numeric($argv[2])) {
        echo "Usage: pppoe_toggle_ha set_vhid <number>\n";
        exit(1);
    }
    $new_vhid = (int)$argv[2];
    $script = file_get_contents(__FILE__);
    $pattern = '/^(\$vhid\s*=\s*)\d+\s*;/m';
    if (preg_match($pattern, $script, $matches)) {
        $new_line = $matches[1] . $new_vhid . ';';
        $script = preg_replace($pattern, $new_line, $script);
        $bak = __FILE__ . '.bak.' . date('YmdHis');
        if (!@copy(__FILE__, $bak)) {
            echo "Warning: could not create backup {$bak}\n";
        }
        $tmp = __FILE__ . '.tmp.' . getmypid();
        if (file_put_contents($tmp, $script) === false) {
            echo "Error: failed to write temp file\n";
            exit(1);
        }
        if (!@rename($tmp, __FILE__)) {
            echo "Error: failed to install updated script\n";
            @copy($bak, __FILE__);
            exit(1);
        }

        echo "VHID updated to {$new_vhid} (backup: {$bak})\n";
        exit(0);
    }
}

require_once("config.inc");
require_once("interfaces.inc");
require_once("services.inc");
require_once("util.inc");

$subsystem = $argv[1] ?? '';
$type = strtoupper($argv[2] ?? '');
$conn = strtolower($argv[3] ?? '');

$vhid = 1;
$state_file = "/tmp/pppoe_toggle_ha.state";
$cooldown_file = '/tmp/pppoe_toggle_ha.cooldown';
$cooldown_time = 10;
$ip_timeout = 30;
$conn_timeout = 300;
$ifkey = 'wan';
$real_iface = get_real_interface($ifkey, "inet");
$track_ifaces = link_interface_to_track6($ifkey);
$ssh_key = '/root/.ssh/secret.ssh';
$nodeA = 'gateway1';
$nodeB = 'gateway2';

function check_cooldown() {
    global $cooldown_file, $cooldown_time;
    $fp = fopen($cooldown_file, 'c+');
    if ($fp === false) {
        return true;
    }
    $allowed = false;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $last = (int)trim(stream_get_contents($fp));
        if (time() - $last >= $cooldown_time) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, (string)time());
            $allowed = true;
        }
        flock($fp, LOCK_UN);
    }
    fclose($fp);
    return $allowed;
}

function pppoe_state($ifkey) {
    if (empty($ifkey)) {
        return ['active' => false, 'ip4' => false, 'ip6' => false];
    }

    $ip4 = get_interface_ip($ifkey);
    $ip6 = get_interface_ipv6($ifkey);

    $ip4 = !empty($ip4) && $ip4 !== '0.0.0.0' && $ip4 !== '127.0.0.1';
    $ip6 = !empty($ip6) && strpos($ip6, 'fe80:') !== 0;

    return [
        'active' => $ip4 || $ip6,
        'ip4' => $ip4,
        'ip6' => $ip6,
    ];
}

function wait_for_wan_ip(int $version): bool
{
    global $ifkey, $ip_timeout;

    $deadline = time() + $ip_timeout;
    while (time() < $deadline) {
        if ($version === 6) {
            $ip = get_interface_ipv6($ifkey);
            $ok = !empty($ip) && strpos($ip, 'fe80:') !== 0;
        } else {
            $ip = get_interface_ip($ifkey);
            $ok = !empty($ip) && $ip !== '0.0.0.0';
        }

        if ($ok) {
            return true;
        }
        usleep(200000);
    }

    return false;
}

function wait_for_conn(): bool
{
    global $conn_timeout;

    $deadline = time() + $conn_timeout;

    $dns_ip = get_interface_ip('lan');
    if (empty($dns_ip) || $dns_ip === '0.0.0.0') {
        $dns_ip = '127.0.0.1';
    }

    while (time() < $deadline) {
        $check_fqdn = 'check-' . mt_rand(1000000, 9999999) . '.tld';
        $out = shell_exec("/usr/bin/dig +time=3 +tries=1 {$check_fqdn} @" . escapeshellarg($dns_ip) . " 2>&1");
        if ($out !== null && strpos($out, 'status: NXDOMAIN') !== false) {
            return true;
        }

        sleep(1);
    }

    return false;
}

function flush_lan_ipv6(): void
{
    global $config, $ifkey, $track_ifaces;

    if (empty($track_ifaces)) {
        return;
    }

    foreach ($track_ifaces as $iface => $ifcfg) {
        if (empty($config['interfaces'][$iface])) {
            continue;
        }

        $real_iface = get_real_interface($iface, 'inet6');
        $ip6 = get_interface_ipv6($iface);

        if (!empty($ip6)) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function flush_wan_ipv6(): void
{
    global $real_iface;

    if (empty($real_iface)) {
        return;
    }

    $out = shell_exec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 2>/dev/null");
    if ($out === null || $out === '') {
        return;
    }

    if (preg_match_all('/inet6\s+([0-9a-fA-F:]+)(?:%[^\s]+)?/i', $out, $m)) {
        foreach ($m[1] as $ip6) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function kill_states_on_interface($iface)
{
    pfSense_kill_states("0.0.0.0/0", $iface);
    pfSense_kill_states("::/0", $iface);
}

function manage_dhcpdv6($mode): void
{
    global $config, $ifkey, $track_ifaces;

    if (empty($track_ifaces)) {
        return;
    }

    $changed = false;
    foreach (array_keys($track_ifaces) as $if) {
        if ($mode === 'enable') {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== 'assist') {
                $config['dhcpdv6'][$if]['ramode'] = 'assist';
                $changed = true;
            }
/*
            if (($config['dhcpdv6'][$if]['rapriority'] ?? '') !== 'medium') {
                $config['dhcpdv6'][$if]['rapriority'] = 'medium';
                $changed = true;
            }
            if (!isset($config['dhcpdv6'][$if]['enable'])) {
                $config['dhcpdv6'][$if]['enable'] = '';
                $changed = true;
            }
*/
        } else {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== 'disabled') {
                $config['dhcpdv6'][$if]['ramode'] = 'disabled';
                $changed = true;
            }
/*
            if (($config['dhcpdv6'][$if]['rapriority'] ?? '') !== 'low') {
                $config['dhcpdv6'][$if]['rapriority'] = 'low';
                $changed = true;
            }
            if (isset($config['dhcpdv6'][$if]['enable'])) {
                unset($config['dhcpdv6'][$if]['enable']);
                $changed = true;
            }
*/
        }
    }

    if ($changed) {
        write_config("CARP: " . ($mode === 'enable' ? 'Enabled' : 'Disabled') . " radvd+DHCPv6 on " . implode(',', array_keys($track_ifaces)), false);
        services_radvd_configure();
/*
        services_dhcpdv6_configure();
*/
    }
}

function update_state_file($state, $write = false): bool
{
    global $vhid, $state_file;

    $new_state = "@{$vhid}|{$state}";
    $fp = fopen($state_file, 'c+');
    if ($fp === false) {
        return true;
    }

    $changed = true;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $old_state = trim(stream_get_contents($fp));
        $changed = ($old_state !== $new_state);

        if ($write && $changed) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, $new_state);
        }

        flock($fp, LOCK_UN);
    }
    fclose($fp);

    return $changed;
}

function apply_carp_state($state): void
{
    global $config, $type, $conn, $ifkey, $real_iface, $pppoe_state, $is_enabled;

    switch ($state) {

        case 'MASTER':
            if (!$pppoe_state['active']) {

                if (mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " up") !== 0) {
                    exit(1);
                }

                if (wait_for_wan_ip(4)) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                } else {
                    exit(1);
                }

                if (!wait_for_wan_ip(6)) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                }
/*
                if (!$is_enabled) {
                    $config['interfaces'][$ifkey]['enable'] = '1';
                    write_config("enable interface '{$ifkey}' due CARP event '{$state}'", false);
                    interface_configure($ifkey);
                }
*/
                if (wait_for_wan_ip(6)) {
                    manage_dhcpdv6('enable');
                }

                if ($conn === 'conn') {
                    if (!wait_for_conn()) {
                        exit(1);
                    }
                }

                mwexec("/usr/local/sbin/pppoe_toggle_ha_master.sh");

            }
            break;

        case 'BACKUP':
            if ($pppoe_state['active']) {

                manage_dhcpdv6('disable');
/*
                if ($is_enabled) {
                    unset($config['interfaces'][$ifkey]['enable']);
                    write_config("disable interface '{$ifkey}' due CARP event '{$state}'", false);
                    interface_configure($ifkey);
                }
*/
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " down");

                kill_states_on_interface($real_iface);
                flush_wan_ipv6();
                flush_lan_ipv6();

                mwexec("/usr/local/sbin/pppoe_toggle_ha_backup.sh");

            }
            break;

        case 'INIT':
        default:
            break;
    }
    update_state_file($state, true);
}

function apply_handover(): void
{
    global $vhid, $carp_state, $ssh_key, $nodeA, $nodeB;

    if ($carp_state !== 'MASTER') {
        exit(1);
    }

    $self_host = strtolower(php_uname('n'));
    $peer_host = '';

    if (strpos($self_host, $nodeA) !== false) {
        $peer_host = $nodeB;
    } elseif (strpos($self_host, $nodeB) !== false) {
        $peer_host = $nodeA;
    } else {
        exit(1);
    }

    exec("ssh -i " . escapeshellarg($ssh_key)
        . " -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
        . " " . escapeshellarg("root@{$peer_host}")
        . " " . escapeshellarg("/usr/local/sbin/pppoe_toggle_ha @{$vhid} MASTER conn && /usr/local/sbin/pfSsh.php playback disablecarpmaint")
        . " 2>&1", $out, $ret);

    if ($ret !== 0) {
        exit(1);
    }

    interfaces_carp_set_maintenancemode(true);

}

function apply_takeover(): void
{
    global $vhid, $carp_state, $ssh_key, $nodeA, $nodeB, $conn;

    if ($carp_state !== 'BACKUP') {
        exit(1);
    }

    $conn = 'conn';
    apply_carp_state('MASTER');

    interfaces_carp_set_maintenancemode(false);

    $self_host = strtolower(php_uname('n'));
    $peer_host = '';

    if (strpos($self_host, $nodeA) !== false) {
        $peer_host = $nodeB;
    } elseif (strpos($self_host, $nodeB) !== false) {
        $peer_host = $nodeA;
    } else {
        exit(1);
    }

    exec("ssh -i " . escapeshellarg($ssh_key)
        . " -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"
        . " " . escapeshellarg("root@{$peer_host}")
        . " " . escapeshellarg("/usr/local/sbin/pfSsh.php playback enablecarpmaint")
        . " 2>&1", $out, $ret);

    if ($ret !== 0) {
        exit(1);
    }
}

$carp_state = preg_match('/carp:\s+(MASTER|BACKUP|INIT)\s+vhid\s+' . preg_quote((string)$vhid, '/') . '/i', shell_exec("/sbin/ifconfig -a 2>/dev/null") ?? '', $m) ? strtoupper($m[1]) : '';
$pppoe_state = pppoe_state($ifkey);
$is_enabled = isset($config['interfaces'][$ifkey]['enable']);

if (isset($argv[1]) && strtoupper($argv[1]) === 'RECONCILE') {
    apply_carp_state($carp_state);
    exit(0);
}

if (isset($argv[1]) && strtoupper($argv[1]) === 'RECONNECT') {
    if ($pppoe_state['active']) {
        interface_configure($ifkey);
    }
    exit(0);
}

if (isset($argv[1]) && strtoupper($argv[1]) === 'HANDOVER') {
    apply_handover();
    exit(0);
}

if (isset($argv[1]) && strtoupper($argv[1]) === 'TAKEOVER') {
    apply_takeover();
    exit(0);
}

if (preg_match('/@(\d+)$/', $subsystem, $matches) || preg_match('/^(\d+)@/', $subsystem, $matches)) {
    $vhidX = (int)$matches[1];
} else {
    exit(1);
}

if (!in_array($type, ['MASTER', 'BACKUP', 'INIT'])) {
    exit(1);
}

if ($vhidX !== $vhid) {
    exit(0);
}

if (!update_state_file($type)) {
    exit(0);
}

if (!check_cooldown()) {
    exit(0);
}

apply_carp_state($type);
