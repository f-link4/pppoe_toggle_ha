function load_config(string $file, array $defaults): array
{
    if (!file_exists($file)) {
        return $defaults;
    }
    $user = parse_ini_file($file);
    if ($user === false) {
        return $defaults;
    }
    $config = array_merge($defaults, $user);
    foreach ($defaults as $key => $default_value) {
        if (is_bool($default_value) && array_key_exists($key, $config)) {
            $config[$key] = filter_var($config[$key], FILTER_VALIDATE_BOOLEAN);
        }
    }
    return $config;
}

function save_config(string $file, array $config): bool
{
    $lines = [
        '; pppoe_toggle_ha configuration',
        '',
    ];
    foreach ($config as $k => $v) {
        if (is_bool($v)) {
            $v = $v ? 'true' : 'false';
        }
        $lines[] = "{$k} = {$v}";
    }
    $content = implode("\n", $lines) . "\n";
    $bak = $file . '.bak.' . date('YmdHis');
    if (file_exists($file)) {
        @copy($file, $bak);
    }
    $tmp = $file . '.tmp.' . getmypid();
    if (file_put_contents($tmp, $content) === false) {
        return false;
    }
    if (!@rename($tmp, $file)) {
        @unlink($tmp);
        return false;
    }
    return true;
}

