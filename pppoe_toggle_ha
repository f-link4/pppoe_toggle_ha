function cooldown(): bool
{
    global $cooldown_file, $cooldown_time;
    $fp = fopen($cooldown_file, 'c+');
    if ($fp === false) {
        return false;
    }
    $blocked = true;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $last = (int)trim(stream_get_contents($fp));
        if (time() - $last >= $cooldown_time) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, (string)time());
            $blocked = false;
        }
        flock($fp, LOCK_UN);
    }
    fclose($fp);
    return $blocked;
}

function pppoe_state(string $ifkey): array
{
    if (empty($ifkey)) {
        return [ 'active' => false, 'ipv4state' => false, 'ipv6state' => false, 'ip4' => null, 'ip6' => null ];
    }
    $ip4 = get_interface_ip($ifkey);
    $ip6 = get_interface_ipv6($ifkey);
    $ipv4state = !empty($ip4) && $ip4 !== '0.0.0.0' && $ip4 !== '127.0.0.1';
    $ipv6state = !empty($ip6) && strpos($ip6, 'fe80:') !== 0;
    return [
        'active'    => $ipv4state || $ipv6state,
        'ipv4state' => $ipv4state,
        'ipv6state' => $ipv6state,
        'ip4'       => $ipv4state ? $ip4 : null,
        'ip6'       => $ipv6state ? $ip6 : null,
    ];
}

function wait_for_wan_ip(int $version): bool
{
    global $ifkey, $ip_timeout;
    $deadline = time() + $ip_timeout;
    while (time() < $deadline) {
        if ($version === 6) {
            if (pppoe_state($ifkey)['ipv6state']) {
                return true;
            }
        } else {
            if (pppoe_state($ifkey)['ipv4state']) {
                return true;
            }
        }
        usleep(200000);
    }
    return false;
}

function wait_for_conn(): bool
{
    global $conn_timeout;
    $deadline = time() + $conn_timeout;
    $dns_ip = get_interface_ip('lan');
    if (empty($dns_ip) || $dns_ip === '0.0.0.0') {
        $dns_ip = '127.0.0.1';
    }
    $domains = ['cloudflare.com', 'github.com'];
    while (time() < $deadline) {
        foreach ($domains as $domain) {
            $check_fqdn = 'check-' . mt_rand(1000000, 9999999) . '.' . $domain;
            $out = shell_exec("/usr/local/bin/dig +time=3 +tries=1 {$check_fqdn} @" . escapeshellarg($dns_ip) . " 2>&1");
            if ($out !== null && strpos($out, 'status: NOERROR') !== false) {
                return true;
            }
        }
        sleep(1);
    }
    return false;
}

function flush_lan_ipv6(): void
{
    global $config, $track_ifaces;
    if (empty($track_ifaces)) {
        return;
    }
    foreach ($track_ifaces as $iface => $ifcfg) {
        if (empty($config['interfaces'][$iface])) {
            continue;
        }
        $real_iface = get_real_interface($iface, 'inet6');
        $ip6 = get_interface_ipv6($iface);
        if (!empty($ip6)) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function flush_wan_ipv6(): void
{
    global $real_iface;
    if (empty($real_iface)) {
        return;
    }
    $out = shell_exec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 2>/dev/null");
    if ($out === null || $out === '') {
        return;
    }
    if (preg_match_all('/inet6\s+([0-9a-fA-F:]+)(?:%[^\s]+)?/i', $out, $m)) {
        foreach ($m[1] as $ip6) {
            $addr = explode('%', $ip6)[0];
            if (filter_var($addr, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " inet6 " . escapeshellarg($addr) . " delete", true);
            }
        }
    }
}

function manage_dhcpdv6(string $mode): void
{
    global $config, $default_config, $track_ifaces, $toggle_dhcpdv6, $toggle_ramode;
    if (empty($track_ifaces)) {
        return;
    }
    $valid_ramodes = ['disabled', 'router', 'unmanaged', 'managed', 'assist', 'stateless'];
    if (!in_array($toggle_ramode, $valid_ramodes, true)) {
        $toggle_ramode = $default_config['toggle_ramode'] ?? 'assist';
    }
    $changed = false;
    foreach (array_keys($track_ifaces) as $if) {
        if ($mode === 'enable') {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== $toggle_ramode) {
                $config['dhcpdv6'][$if]['ramode'] = $toggle_ramode;
                $changed = true;
            }
/*
            if (($config['dhcpdv6'][$if]['rapriority'] ?? '') !== 'medium') {
                $config['dhcpdv6'][$if]['rapriority'] = 'medium';
                $changed = true;
            }
*/
            if ($toggle_dhcpdv6 && !isset($config['dhcpdv6'][$if]['enable'])) {
                $config['dhcpdv6'][$if]['enable'] = '';
                $changed = true;
            }
        } else {
            if (($config['dhcpdv6'][$if]['ramode'] ?? '') !== 'disabled') {
                $config['dhcpdv6'][$if]['ramode'] = 'disabled';
                $changed = true;
            }
/*
            if (($config['dhcpdv6'][$if]['rapriority'] ?? '') !== 'low') {
                $config['dhcpdv6'][$if]['rapriority'] = 'low';
                $changed = true;
            }
*/
            if ($toggle_dhcpdv6 && isset($config['dhcpdv6'][$if]['enable'])) {
                unset($config['dhcpdv6'][$if]['enable']);
                $changed = true;
            }
        }
    }
    if ($changed) {
        write_config("CARP: " . ($mode === 'enable' ? 'Enabled' : 'Disabled') . " radvd+DHCPv6 on " . implode(',', array_keys($track_ifaces)), false);
        services_radvd_configure();
        if ($toggle_dhcpdv6) {
            services_dhcpdv6_configure();
        }
    }
}

function update_state_file(string $state, bool $write = false): bool
{
    global $vhid, $state_file;
    $new_state = "@{$vhid}|{$state}";
    $fp = fopen($state_file, 'c+');
    if ($fp === false) {
        return true;
    }
    $changed = true;
    if (flock($fp, LOCK_EX)) {
        rewind($fp);
        $old_state = trim(stream_get_contents($fp));
        $changed = ($old_state !== $new_state);
        if ($write && $changed) {
            ftruncate($fp, 0);
            rewind($fp);
            fwrite($fp, $new_state);
        }
        flock($fp, LOCK_UN);
    }
    fclose($fp);
    return $changed;
}

function apply_carp_state(string $state): void
{
    global $config, $conn, $ifkey, $real_iface, $pppoe_state, $is_enabled, $toggle_wan_gui;
    switch ($state) {
        case 'MASTER':
            if (!$pppoe_state['active']) {
                if (mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " up") !== 0) {
                    exit(1);
                }
                if (wait_for_wan_ip(4)) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                } else {
                    exit(1);
                }
                if (!wait_for_wan_ip(6)) {
                    interface_dhcpv6_configure($real_iface, $config['interfaces'][$ifkey], true);
                }
                if ($toggle_wan_gui && !$is_enabled) {
                    $config['interfaces'][$ifkey]['enable'] = '1';
                    write_config("enable interface '{$ifkey}' due CARP event '{$state}'", false);
                    //interface_configure($ifkey);
                }
                if (wait_for_wan_ip(6)) {
                    manage_dhcpdv6('enable');
                }
                if ($conn === 'conn') {
                    if (!wait_for_conn()) {
                        exit(1);
                    }
                }
                mwexec("/usr/local/sbin/pppoe_toggle_ha_master.sh");
            }
            break;
        case 'BACKUP':
            if ($pppoe_state['active']) {
                manage_dhcpdv6('disable');
                if ($toggle_wan_gui && $is_enabled) {
                    unset($config['interfaces'][$ifkey]['enable']);
                    write_config("disable interface '{$ifkey}' due CARP event '{$state}'", false);
                    //interface_configure($ifkey);
                }
                mwexec("/sbin/ifconfig " . escapeshellarg($real_iface) . " down");
                if (!empty($pppoe_state['ip4'])) {
                    mwexec("/sbin/pfctl -k " . escapeshellarg($pppoe_state['ip4']), true);
                }
                if (!empty($pppoe_state['ip6'])) {
                    mwexec("/sbin/pfctl -k " . escapeshellarg($pppoe_state['ip6']), true);
                }
                flush_wan_ipv6();
                flush_lan_ipv6();
                mwexec("/usr/local/sbin/pppoe_toggle_ha_backup.sh");
            }
            break;
        case 'INIT':
        default:
            break;
    }
    update_state_file($state, true);
}

function resolve_peer(): array
{
    global $config, $nodeA, $nodeB;

    $iface = (string)($config['hasync']['pfsyncinterface'] ?? '');
    if ($iface === '') {
        return ['error' => 'HA sync interface not configured'];
    }
    $self = (string)($config['interfaces'][$iface]['ipaddr'] ?? '');
    if ($self === '') {
        return ['error' => "HA sync interface '{$iface}' has no IP assigned"];
    }
    $nodeA = (string)$nodeA;
    $nodeB = (string)$nodeB;
    if ($nodeA === '' || $nodeB === '') {
        return ['error' => 'nodeA/nodeB not set — reinstall or set manually'];
    }
    if ($self === $nodeA) {
        return ['self' => $self, 'peer' => $nodeB];
    }
    if ($self === $nodeB) {
        return ['self' => $self, 'peer' => $nodeA];
    }
    return ['error' => "Self IP {$self} does not match nodeA ({$nodeA}) or nodeB ({$nodeB})"];
}

function peer_cmd(string $cmd): bool
{
    global $ssh_key;

    $r = resolve_peer();
    if (isset($r['error'])) {
        return false;
    }
    $out = [];
    $ret = 0;
    exec(
        "/usr/bin/ssh -T -i " . escapeshellarg($ssh_key)
        . " -o StrictHostKeyChecking=accept-new"
        . " -o ConnectTimeout=10 "
        . escapeshellarg("root@{$r['peer']}")
        . " " . escapeshellarg($cmd)
        . " 2>&1",
        $out,
        $ret
    );
    return $ret === 0;
}

function apply_handover(): void
{
    global $vhid, $carp_state;
    if ($carp_state !== 'MASTER') {
        exit(1);
    }
    if (!peer_cmd("/usr/local/sbin/pppoe_toggle_ha @" . (int)$vhid . " MASTER conn && /usr/local/sbin/pfSsh.php playback disablecarpmaint")) {
        exit(1);
    }
    interfaces_carp_set_maintenancemode(true);
}

function apply_takeover(): void
{
    global $carp_state, $conn;
    if ($carp_state !== 'BACKUP') {
        exit(1);
    }
    $conn = 'conn';
    apply_carp_state('MASTER');
    interfaces_carp_set_maintenancemode(false);
    if (!peer_cmd("/usr/local/sbin/pfSsh.php playback enablecarpmaint")) {
        exit(1);
    }
}

function store_ssh(): int
{
    global $config, $ssh_key;

    if (!file_exists($ssh_key)) {
        echo "[FAIL] SSH key not found: {$ssh_key}\n";
        return 1;
    }

    $pub = shell_exec("/usr/bin/ssh-keygen -y -f " . escapeshellarg($ssh_key) . " 2>/dev/null");
    if (empty($pub) || strpos($pub, 'ssh-') !== 0) {
        echo "[FAIL] Cannot read public key from {$ssh_key}\n";
        return 1;
    }
    $pub_trim = trim($pub);
    $b64 = base64_encode($pub_trim);

    $changed = false;

    foreach ($config['system']['user'] as &$user) {
        if ((string)$user['name'] !== 'admin') {
            continue;
        }

        $existing = (string)($user['authorizedkeys'] ?? '');
        $valid_keys = [];

        foreach (preg_split("/\s+/", $existing) as $k) {
            if ($k === "") {
                continue;
            }
            if (base64_decode($k, true) !== false) {
                $valid_keys[] = $k;
            }
        }

        if (!in_array($b64, $valid_keys, true)) {
            $valid_keys[] = $b64;
            $changed = true;
        }

        $new_value = implode("\n", $valid_keys);

        if ($new_value !== $existing) {
            $user['authorizedkeys'] = $new_value;
            $changed = true;
        }

        break;
    }
    unset($user);

    if ($changed) {
        write_config("pppoe_toggle_ha: update SSH key for admin", false);
        echo "[ OK ] Key stored in config.xml\n";
    } else {
        echo "[ OK ] Key already present in config.xml\n";
    }

    return 0;
}

function diag_ssh(): int
{
    global $config, $nodeA, $nodeB, $ssh_key, $vhid;

    $ok = true;

    echo "=== pppoe_toggle_ha diag_ssh ===\n";
    echo "VHID:     {$vhid}\n";
    echo "SSH key:  {$ssh_key}\n";
    echo "nodeA:    " . ($nodeA !== '' ? $nodeA : '(not set)') . "\n";
    echo "nodeB:    " . ($nodeB !== '' ? $nodeB : '(not set)') . "\n";
    echo "---\n";

    if (!file_exists($ssh_key)) {
        echo "[FAIL] SSH key not found: {$ssh_key}\n";
        return 1;
    }
    echo "[ OK ] SSH key exists\n";

    $perms = substr(sprintf('%o', fileperms($ssh_key)), -3);
    if ($perms !== '600') {
        echo "[WARN] SSH key permissions are {$perms}, expected 600\n";
        $ok = false;
    } else {
        echo "[ OK ] SSH key permissions are 600\n";
    }

    $pub = shell_exec("/usr/bin/ssh-keygen -y -f " . escapeshellarg($ssh_key) . " 2>/dev/null");
    if (empty($pub) || strpos($pub, 'ssh-') !== 0) {
        echo "[FAIL] Cannot read public key from {$ssh_key}\n";
        return 1;
    }
    echo "[ OK ] Public key readable: " . substr(trim($pub), 0, 40) . "...\n";

    $auth_keys = '/root/.ssh/authorized_keys';
    $pub_trim = trim($pub);
    if (file_exists($auth_keys)) {
        $auth_content = file_get_contents($auth_keys);
        if (strpos($auth_content, $pub_trim) !== false) {
            echo "[ OK ] Public key present in {$auth_keys}\n";
        } else {
            echo "[WARN] Public key NOT found in {$auth_keys} — peer cannot SSH into this node\n";
            $ok = false;
        }
    } else {
        echo "[WARN] {$auth_keys} does not exist — peer cannot SSH into this node\n";
        $ok = false;
    }

    $r = resolve_peer();
    if (isset($r['error'])) {
        echo "[FAIL] {$r['error']}\n";
        return 1;
    }
    echo "[ OK ] Self sync IP: {$r['self']}\n";
    echo "[ OK ] Peer sync IP: {$r['peer']}\n";

    if (peer_cmd('hostname')) {
        echo "[ OK ] Peer reachable via SSH\n";
    } else {
        echo "[FAIL] Peer not reachable via SSH\n";
        echo "       Hint: run 'ssh -T -i {$ssh_key} root@{$r['peer']} hostname' manually.\n";
        $ok = false;
    }

    echo "---\n";
    echo $ok ? "Result: OK\n" : "Result: WARNINGS/FAILURES\n";
    return $ok ? 0 : 1;
}

$carp_state = preg_match('/carp:\s+(MASTER|BACKUP|INIT)\s+vhid\s+' . preg_quote((string)$vhid, '/') . '(?!\d)/i', shell_exec("/sbin/ifconfig -a 2>/dev/null") ?? '', $m) ? strtoupper($m[1]) : '';
